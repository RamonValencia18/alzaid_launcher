---
/* src/components/GamePanel.astro */
---
<dialog id="game-panel-dialog" class="game-modal">
  <div class="modal-card">
    <button id="close-panel" class="close-btn" aria-label="Cerrar">&times;</button>

    <div class="modal-media">
      <img id="panel-img" src="" alt="" class="modal-image" />
      <div id="panel-img-fallback" class="modal-image-fallback" style="display: none;">
        Sin imagen disponible
      </div>
    </div>

    <div class="modal-info">
      <span id="panel-type" class="game-badge"></span>
      <h2 id="panel-title" class="modal-heading"></h2>
      <p id="panel-description" class="modal-desc"></p>

      <div class="modal-actions">
        <button id="panel-play-btn" class="play-btn">Iniciar Juego</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import type { Game } from "../objects/Game";

  const dialog = document.getElementById("game-panel-dialog") as HTMLDialogElement | null;
  const closeBtn = document.getElementById("close-panel");
  const playBtn = document.getElementById("panel-play-btn");

  const panelImg = document.getElementById("panel-img") as HTMLImageElement;
  const panelImgFallback = document.getElementById("panel-img-fallback") as HTMLDivElement;
  const panelType = document.getElementById("panel-type")!;
  const panelTitle = document.getElementById("panel-title")!;
  const panelDesc = document.getElementById("panel-description")!;

  let selectedGameId: string | null = null;

  // Escuchar el evento personalizado global 'game:open'
  window.addEventListener("game:open", (e: Event) => {
    const customEvent = e as CustomEvent<{ game: Game }>;
    const { game } = customEvent.detail;

    if (!game) return;

    selectedGameId = game.id;
    const imageSrc = game.imageURL ?? game.iconURL;

    if (imageSrc) {
      panelImg.src = imageSrc;
      panelImg.alt = game.name;
      panelImg.style.display = "block";
      if (panelImgFallback) panelImgFallback.style.display = "none";
    } else {
      panelImg.style.display = "none";
      if (panelImgFallback) panelImgFallback.style.display = "flex";
    }

    panelType.textContent = game.type || "General";
    panelTitle.textContent = game.name;
    panelDesc.textContent = game.description || "Sin descripción disponible.";

    dialog?.showModal();
  });

  // Cerrar al hacer clic en el botón de cerrar (X)
  closeBtn?.addEventListener("click", () => dialog?.close());

  // Cerrar al hacer clic fuera del panel (backdrop)
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  // Iniciar juego
  playBtn?.addEventListener("click", () => {
  if (selectedGameId) {
    const urlParams = new URLSearchParams(window.location.search);
    const patientId = urlParams.get("patientId");
    
    const targetUrl = patientId
      ? `/games/${selectedGameId}/play?patientId=${patientId}`
      : `/games/${selectedGameId}/play`;

    window.location.href = targetUrl;
  }
});
</script>

<style>
  .game-modal {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: 500px;
    width: 90%;
    background: transparent;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    position: fixed;
    inset: 0;
    margin: auto;
  }

  .game-modal::backdrop {
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }

  .modal-card {
    position: relative;
    background: #ffffff;
    border-radius: 12px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .close-btn {
    position: absolute;
    top: 12px;
    right: 16px;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: #9ca3af;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .close-btn:hover {
    color: #1f2937;
  }

  .modal-media {
    width: 100%;
    height: 180px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f3f4f6;
  }

  .modal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .modal-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  .modal-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .game-badge {
    display: inline-block;
    padding: 2px 10px;
    background-color: #e0e7ff;
    color: #3730a3;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 9999px;
    text-transform: uppercase;
  }

  .modal-heading {
    margin: 0;
    font-size: 1.35rem;
    color: #111827;
    font-weight: 700;
  }

  .modal-desc {
    margin: 0;
    font-size: 0.95rem;
    color: #4b5563;
    line-height: 1.5;
  }

  .modal-actions {
    width: 100%;
    margin-top: 8px;
    display: flex;
    justify-content: flex-end;
  }

  .play-btn {
    background-color: #4f46e5;
    color: #ffffff;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .play-btn:hover {
    background-color: #4338ca;
  }
</style>